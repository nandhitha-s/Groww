# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# PostgreSQL connection string (Supabase-hosted).
# Format: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# --- Authentication session / cookie settings (all optional, shown with defaults) ---

# How long a session (and its cookie) stays valid, in minutes.
SESSION_EXPIRE_MINUTES=10080

# Name of the HttpOnly authentication cookie.
COOKIE_NAME=session_token

# Only send the cookie over HTTPS. Keep true in production.
# Set to false for local development over plain http://localhost.
COOKIE_SECURE=true

# Cookie SameSite policy: lax, strict, or none.
COOKIE_SAMESITE=lax

# --- Market data ---
# The active market-data provider is Yahoo Finance via the `yfinance`
# library. It needs NO configuration here -- no API key, no account,
# no OAuth. Nothing to set for it.

# --- FYERS API v3. Optional, NOT the active provider (see README) --
# kept only as a dormant alternative for possible future use. Requires a
# FYERS broker account and a daily interactive login, so it is not used
# by default. NEVER put real values here.

# From your FYERS API app (myapi.fyers.in).
FYERS_APP_ID=YOUR_APP_ID

# Generated via an interactive login flow -- short-lived, typically valid
# for one trading day only. Not wired into any route by default.
FYERS_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
